# ── Primary AI Provider: Groq (Ultra-Fast Chalkboard Generation) ──
# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: override Groq model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Backup AI Provider: OpenAI (Reliable Fallback) ─────────────────
# Automatically used if Groq is rate-limited, down, or missing
OPENAI_API_KEY=sk-your_openai_key_here

# Optional: override OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: extra origins allowed to call the API from a browser (comma-separated, exact match)
# ALLOWED_ORIGINS=https://myschool.example
