# ── Google Gemini API (Recommended: gemini-2.0-flash) ───────────────
# Get your free Gemini API key at https://aistudio.google.com/apikey
# Free tier gives: 1,000,000 tokens/min, 15 requests/min, 1,500 requests/day
GEMINI_API_KEY=your_gemini_key_here

# Optional: override Gemini model (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: extra origins allowed to call the API from a browser (comma-separated, exact match)
# ALLOWED_ORIGINS=https://myschool.example
