{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/lesson", "destination": "/api/lesson" },
    { "source": "/api/ask",    "destination": "/api/ask"    },
    { "source": "/(.*)",       "destination": "/public/$1"  }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/404", "dest": "/public/404.html", "status": 404 }
  ]
}
